{
  "entities": {
    "DiaryEntry": {
      "title": "DiaryEntry",
      "description": "A private journal entry captured via voice stream-of-consciousness or text, optionally reorganized and reflected on by Gemini without judgment.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "dateKey": { "type": "string" },
        "title": { "type": "string" },
        "rawTranscript": { "type": "string" },
        "reorganizedText": { "type": "string" },
        "mainTheme": { "type": "string" },
        "themes": { "type": "array" },
        "sentimentLabel": { "type": "string" },
        "sentimentValence": { "type": "integer" },
        "mentalClarity": { "type": "integer" },
        "reflectionQuestion": { "type": "string" },
        "reflectionAnswer": { "type": "string" },
        "takeaway": { "type": "string" },
        "usedVoice": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "dateKey", "title", "rawTranscript", "reorganizedText",
        "mainTheme", "themes", "sentimentLabel", "sentimentValence",
        "mentalClarity", "reflectionQuestion", "reflectionAnswer",
        "takeaway", "usedVoice", "createdAt", "updatedAt"
      ]
    },
    "WeeklySummary": {
      "title": "WeeklySummary",
      "description": "Non-judgmental weekly synthesis and recurring sentiment analysis generated by Gemini.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "periodLabel": { "type": "string" },
        "headline": { "type": "string" },
        "summary": { "type": "string" },
        "recurringSentiments": { "type": "array" },
        "recurringThemes": { "type": "array" },
        "recurringPatterns": { "type": "string" },
        "weeklyQuestion": { "type": "string" },
        "entryCount": { "type": "integer" },
        "averageValence": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "periodLabel", "headline", "summary",
        "recurringSentiments", "recurringThemes", "recurringPatterns",
        "weeklyQuestion", "entryCount", "averageValence",
        "createdAt", "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Optional user-provided personal context used to tailor Gemini reflections.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "preferredName": { "type": "string" },
        "ageRange": { "type": "string" },
        "lifestyleTags": { "type": "array" },
        "lifestyleNotes": { "type": "string" },
        "keyRelationships": { "type": "array" },
        "relationshipsNote": { "type": "string" },
        "mainConcerns": { "type": "array" },
        "concernsNote": { "type": "string" },
        "reflectionStyle": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" },
        "onboardingSkipped": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "preferredName", "ageRange", "lifestyleTags",
        "lifestyleNotes", "keyRelationships", "relationshipsNote",
        "mainConcerns", "concernsNote", "reflectionStyle",
        "onboardingCompleted", "onboardingSkipped",
        "createdAt", "updatedAt"
      ]
    },
    "SavedAphorism": {
      "title": "SavedAphorism",
      "description": "On-demand evocative aphorism or shareable quote saved to the user's personal register.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "entryId": { "type": "string" },
        "quoteText": { "type": "string" },
        "attribution": { "type": "string" },
        "momentLabel": { "type": "string" },
        "themeTag": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "entryId", "quoteText", "attribution",
        "momentLabel", "themeTag", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/entries/{entryId}": {
      "schema": { "$ref": "#/entities/DiaryEntry" },
      "description": "Private diary entries owned exclusively by userId."
    },
    "/users/{userId}/weeklySummaries/{summaryId}": {
      "schema": { "$ref": "#/entities/WeeklySummary" },
      "description": "Weekly summaries owned exclusively by userId."
    },
    "/users/{userId}/profile/{profileId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Optional personal context profile owned exclusively by userId."
    },
    "/users/{userId}/aphorisms/{aphorismId}": {
      "schema": { "$ref": "#/entities/SavedAphorism" },
      "description": "Saved evocative quotes and aphorisms owned exclusively by userId."
    }
  }
}
